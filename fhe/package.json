{
  "name": "gambit-encrypted-confrontation",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:sepolia": "hardhat test --network sepolia",
    "typecheck": "tsc --noEmit",
    "deploy:sepolia": "hardhat run --network sepolia scripts/deploy-sepolia.ts",
    "check:sepolia": "hardhat run --network sepolia scripts/check-signer.ts",
    "check:3v3:sepolia": "hardhat run --network sepolia scripts/check-3v3.ts",
    "seal:sepolia": "hardhat run --network sepolia scripts/seal-policy-sepolia.ts",
    "deploy:squad:sepolia": "hardhat run --network sepolia scripts/deploy-squad-sepolia.ts",
    "check:squad:sepolia": "hardhat run --network sepolia scripts/deploy-squad-sepolia.ts",
    "preflight:squad:public": "hardhat run --network sepolia scripts/preflight-squad-sepolia.ts",
    "hcu:static": "ts-node scripts/hcu-static.ts",
    "probe:squad:sdk:readonly": "hardhat run --network sepolia scripts/probe-squad-sdk-readonly.ts"
  },
  "dependencies": {
    "@fhevm/solidity": "^0.11.1",
    "@zama-fhe/sdk": "^3.8.0"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "^0.4.2",
    "@fhevm/mock-utils": "^0.4.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.19.30",
    "chai": "^4.5.0",
    "ethers": "^6.16.0",
    "hardhat": "^2.28.6",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
